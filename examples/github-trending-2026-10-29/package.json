{
  "name": "kieu-studio-github-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "avatar": ".venv/bin/python ../../skills/kieu-github-video/scripts/prepare_avatar.py --project .",
    "timeline:preview": ".venv/bin/python scripts/build_timeline.py --preview && .venv/bin/python scripts/make_envelope.py --preview",
    "studio": "npm run timeline:preview && remotion studio src/index.ts",
    "render:review": ".venv/bin/python scripts/render.py --review",
    "voice:check": ".venv/bin/python scripts/voicestudio.py --check",
    "voice:voices": ".venv/bin/python scripts/voicestudio.py --voices",
    "voice:generate": ".venv/bin/python scripts/voicestudio.py --synthesize",
    "timeline:release": ".venv/bin/python scripts/build_timeline.py && .venv/bin/python scripts/make_envelope.py",
    "render:release": ".venv/bin/python scripts/render.py --release",
    "qa": ".venv/bin/python scripts/qa.py",
    "test": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py' -v",
    "lipsync": ".venv/bin/python ../../skills/kieu-github-video/scripts/make_lipsync.py --project ."
  },
  "dependencies": {
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
